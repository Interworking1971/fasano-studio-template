{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Fasano Studio — Editorial Design System",
  "version": "1.0.0",
  "description": "Machine-readable mirror of app/styles/tokens.css. Use this to sync the system into Figma, Style Dictionary, Tailwind or a native app. tokens.css remains the runtime source of truth.",
  "color": {
    "palette": {
      "white": "#ffffff",
      "black": "#000000",
      "bone-100": "#f4f1ec",
      "bone-200": "#ece7df",
      "bone-300": "#e0d5c7",
      "grey-100": "#f8f8f8",
      "grey-300": "#d9d9d9",
      "grey-600": "#97928b",
      "grey-900": "#171614",
      "clay": "#b4552d",
      "olive": "#5c5f4a",
      "red": "#9d1414",
      "orange": "#e97e00"
    },
    "semantic": {
      "background-primary": "{color.palette.bone-100}",
      "background-secondary": "{color.palette.bone-300}",
      "background-inverse": "{color.palette.grey-900}",
      "text-primary": "{color.palette.grey-900}",
      "text-secondary": "{color.palette.grey-600}",
      "text-inverse": "{color.palette.bone-100}",
      "accent": "{color.palette.clay}",
      "line": "rgb(23 22 20 / 14%)",
      "error": "{color.palette.red}"
    }
  },
  "font": {
    "family": {
      "primary": "Instrument Serif, Georgia, 'Times New Roman', Garamond, serif",
      "content": "Instrument Sans, 'Helvetica Neue', Helvetica, Arial, sans-serif"
    },
    "weight": { "regular": 400, "medium": 500 },
    "scale": {
      "header":    { "mobile": "46px/1",      "desktop": "clamp(46px, 5vw, 120px)/1", "family": "primary" },
      "display-1": { "mobile": "2.875rem/1.1", "desktop": "7.5rem/1",     "family": "primary" },
      "display-2": { "mobile": "2.1875rem/1",  "desktop": "2.5rem/1",     "family": "primary" },
      "display-3": { "mobile": "1.5625rem/1.3","desktop": "5rem/1",       "family": "primary" },
      "display-4": { "mobile": "1.25rem/1.15", "desktop": "1.875rem/1.06","family": "content", "weight": "medium" },
      "display-5": { "mobile": "1.125rem/1.5", "desktop": "1.3125rem/1",  "family": "primary" },
      "body":      { "mobile": "1.125rem/1.5", "desktop": "1.125rem/1.5", "family": "content" },
      "button":    { "mobile": "0.9375rem/1",  "desktop": "0.9375rem/1",  "family": "content" },
      "label-1":   { "mobile": "1rem/1.1",     "desktop": "1.125rem/1.1", "family": "primary" },
      "label-2":   { "mobile": "0.9375rem/1.5","desktop": "1.125rem/1.5", "family": "content", "weight": "medium" },
      "tiny-1":    { "mobile": "0.8125rem/1.6","desktop": "0.8125rem/1.6","family": "content" },
      "tiny-2":    { "mobile": "0.625rem/1.4", "desktop": "0.625rem/1.4", "family": "content" }
    }
  },
  "grid": {
    "columns": { "mobile": 2, "desktop": 12 },
    "grid-gap": "10px",
    "gap": { "mobile": "20px", "tablet": "30px", "wide": "40px" },
    "section-gap": { "mobile": "100px", "tablet": "160px", "wide": "200px" },
    "max-width": "1920px"
  },
  "easing": {
    "in-sine": "cubic-bezier(0.12, 0, 0.39, 0)",
    "out-sine": "cubic-bezier(0.61, 1, 0.88, 1)",
    "in-quad": "cubic-bezier(0.55, 0.085, 0.68, 0.53)",
    "out-quad": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "in-out-quad": "cubic-bezier(0.455, 0.03, 0.515, 0.955)",
    "in-cubic": "cubic-bezier(0.32, 0, 0.67, 0)",
    "out-cubic": "cubic-bezier(0.33, 1, 0.68, 1)",
    "in-out-cubic": "cubic-bezier(0.65, 0, 0.35, 1)",
    "in-quart": "cubic-bezier(0.5, 0, 0.75, 0)",
    "out-quart": "cubic-bezier(0.25, 1, 0.5, 1)",
    "in-out-quart": "cubic-bezier(0.76, 0, 0.24, 1)",
    "in-quint": "cubic-bezier(0.64, 0, 0.78, 0)",
    "out-quint": "cubic-bezier(0.22, 1, 0.36, 1)",
    "in-out-quint": "cubic-bezier(0.83, 0, 0.17, 1)",
    "out-expo": "cubic-bezier(0.19, 1, 0.22, 1)",
    "in-out-expo": "cubic-bezier(0.87, 0, 0.13, 1)",
    "in-out-circ": "cubic-bezier(0.85, 0, 0.15, 1)",
    "custom-1": "cubic-bezier(0.25, 0.1, 0.25, 1)",
    "custom-1-reverse": "cubic-bezier(0.75, 0, 0.75, 0.9)"
  },
  "duration": { "fast": "0.3s", "base": "0.6s", "slow": "1s", "stagger-step": "80ms" }
}
